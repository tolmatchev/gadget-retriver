{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "identifier",
      "marketingName",
      "source",
      "sourceRevision"
    ],
    "properties": {
      "identifier": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "marketingName": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "sourceRevision": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
